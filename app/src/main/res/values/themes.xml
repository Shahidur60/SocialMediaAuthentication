<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SocialMediaAttack" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/core_ultramarine</item>
        <item name="colorPrimaryVariant">@color/core_ultramarine_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="TextSecure.LightActionBar.TabBar"
        parent="@style/Widget.AppCompat.ActionBar.TabBar">
        <item name="android:background">@color/core_ultramarine</item>
        <item name="background">@color/core_ultramarine</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#BFffffff</item>
        <item name="elevation">4dp</item>
    </style>

</resources>